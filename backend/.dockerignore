# ── Dependencies & build output (rebuilt inside the image) ──────────────────
node_modules
dist
build
coverage
.nyc_output

# ── Local env & secrets (NEVER bake into an image) ──────────────────────────
.env
.env.*
!.env.example

# ── VCS / CI / editor noise ─────────────────────────────────────────────────
.git
.gitignore
.github
.gitlab-ci.yml
.vscode
.idea
*.swp

# ── Logs & temp ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp
.tmp

# ── Test / tooling config not needed at runtime ─────────────────────────────
test
*.spec.ts
*.e2e-spec.ts
.eslintrc*
.prettierrc*
jest.config*

# ── Docs & misc ─────────────────────────────────────────────────────────────
README.md
Dockerfile
.dockerignore
docker-compose*.yml
